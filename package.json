{
  "name": "epicycle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy",
    "dev:worker": "vite build && wrangler dev"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "catppuccin-neu": "github:BalajiLeninrajan/catppuccin-neu#v0.4.1",
    "comlink": "^4.4.2",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
