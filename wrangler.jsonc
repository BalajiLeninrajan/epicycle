{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "epicycle",
  "main": "./server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the share API runs the Worker; everything else is a static asset or the SPA shell.
    "run_worker_first": ["/api/*"]
  },
  // No id: Wrangler creates the namespace on first deploy (and a local one for wrangler dev).
  "kv_namespaces": [{ "binding": "SHARES" }],
  "ratelimits": [
    {
      "name": "SHARE_LIMIT",
      "namespace_id": "4401",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
